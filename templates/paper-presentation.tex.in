% Equation frame: every symbol newly introduced here is defined in the single
% notationbox directly below the formulas, and nowhere else (not in bullets,
% prose, or captions). Full audit in SOURCES.md. Delete when not needed.
\begin{frame}{Training fits the predictor to targets}
  \begin{equation*}
    \widehat y_t=f_\theta(x_{1:t},c),
    \qquad
    \theta^\star=\arg\min_\theta \mathcal L(\widehat y_t,y_t)
  \end{equation*}
  \begin{notationbox}
    \nt{$x_{1:t}$}{observed inputs up to step $t$}
    \nt{$c$}{conditioning signal}
    \nt{$f_\theta$}{the network}
    \nt{$\theta$}{network weights}
    \nt{$\widehat y_t,\ y_t$}{prediction and target at step $t$}
    \nt{$\mathcal L$}{training loss}
    \nt{$\theta^\star$}{weights that minimize $\mathcal L$}
  \end{notationbox}
  \small What minimizing $\mathcal L$ achieves, in one sentence.
  \framesource{Paper Eq. X and Sec. Y}
\end{frame}

