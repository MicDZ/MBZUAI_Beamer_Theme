% notationbox: the ONE place on a slide where formula symbols are defined.
% Same style and position (directly below the formulas) on every slide.
% One \nt{symbol}{meaning} per symbol; entries fill columns left to right,
% then wrap (default 3 per line). Use [2] for long meanings, [1] for one per line.
%   \begin{notationbox}
%     \nt{$Q$}{queries, one row per position}
%     \nt{$d_k$}{key/query dimension}
%   \end{notationbox}
\newlength{\ntwidth}\newlength{\ntgap}\setlength{\ntgap}{1.2em}
\newcommand{\nt}[2]{%
  \parbox[t]{\ntwidth}{\raggedright\hangindent=1.2em\hangafter=1 #1\enspace #2}%
  \hskip\dimexpr\ntgap\relax plus 1fil\relax\ignorespaces}
\newenvironment{notationbox}[1][3]{%
  \setbeamercolor{block title}{bg=mbzuai-dark-navy,fg=white}%
  \begin{block}{Notation}\footnotesize
  \setlength{\ntwidth}{\dimexpr(\linewidth-\ntgap*(#1-1))/#1\relax}%
  \raggedright\setlength{\lineskip}{3pt}\setlength{\lineskiplimit}{2pt}\noindent\ignorespaces
}{%
  \par\end{block}%
}
% \focuscrop[<includegraphics options>]{<file>}{<clear windows>}
% Dims everything except the given windows, so one overview figure can be
% reused stage by stage. Coordinates are fractions of the image (0..1).
% Keep each stage's input and output inside a window; never draw over content.
% Example: \focuscrop[width=\linewidth]{overview.pdf}{(.11,.04) rectangle (.31,.60)}
\newcommand{\focuscrop}[3][]{%
  \begin{tikzpicture}
    \node[anchor=south west,inner sep=0] (fc) at (0,0) {\includegraphics[#1]{#2}};
    \begin{scope}[x={(fc.south east)},y={(fc.north west)}]
      \fill[white,opacity=.62,even odd rule] (0,0) rectangle (1,1) #3;
    \end{scope}
  \end{tikzpicture}}

